<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <Placemark>
      <name>Ermita de San Bernabé</name>
      <description>
                    Ermita de San Bernabé en Alto de la Concha, inicio de la ruta PRC-BU 32
                    por Ojo Guareña.
                </description>
      <Point>
        <coordinates>-3.664126551908265,43.03349878431261,20.0</coordinates>
        <altitudeMode>relativeToGround</altitudeMode>
      </Point>
    </Placemark>
    <Placemark>
      <name>Complejo kárstico Ojo Guareña</name>
      <description>
                    Galerías y simas kársticas con formaciones geológicas singulares y
                    entorno natural protegido.
                </description>
      <Point>
        <coordinates>-3.662771990151664,43.03446066806564,20.0</coordinates>
        <altitudeMode>relativeToGround</altitudeMode>
      </Point>
    </Placemark>
    <Placemark>
      <name>El Ventanón</name>
      <description>
                    El Ventanón, arco natural de 30 metros de ancho y 20 de alto formado
                    por erosión kárstica.
                </description>
      <Point>
        <coordinates>-3.713001893396484,43.02588272793076,20.0</coordinates>
        <altitudeMode>relativeToGround</altitudeMode>
      </Point>
    </Placemark>
    <Placemark>
      <name>Iglesia de San Esteban de Villamartín de Sotoscueva</name>
      <description>
                    Iglesia románica del siglo XIII, una de las joyas del románico rural de
                    la zona.
                </description>
      <Point>
        <coordinates>-3.685455968157841,43.02217734688335,20.0</coordinates>
        <altitudeMode>relativeToGround</altitudeMode>
      </Point>
    </Placemark>
    <Placemark>
      <name>Pico El Cuerno</name>
      <description>
                    Pico El Cuerno, punto más alto de la zona con vistas panorámicas del
                    entorno natural.
                </description>
      <Point>
        <coordinates>-3.668985505699476,43.0367423860501,20.0</coordinates>
        <altitudeMode>relativeToGround</altitudeMode>
      </Point>
    </Placemark>
